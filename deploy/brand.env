# Single source of truth for the build-time rebrand.
#
# deploy/rebrand.sh reads this to rewrite the working tree, and the CI
# workflow sources it into $GITHUB_ENV so artifact globs match what the
# build actually produces. Change the values here and nowhere else.
#
# The tree itself stays on the upstream Amnezia naming so that merges
# from amnezia-vpn/amnezia-client keep applying cleanly; the rebrand is
# applied per build.
BRAND_APP_NAME=PmneziaVPN
BRAND_LOWER=pmneziavpn
BRAND_ANDROID_PACKAGE=org.pmnezia.vpn
BRAND_ANDROID_DIR=pmnezia
BRAND_APPLE_ID_PREFIX=org.pmnezia
BRAND_HOMEPAGE=https://github.com/coffeegrind123/amnezia-client
BRAND_SUPPORT_URL=https://github.com/coffeegrind123/amnezia-client/issues
